# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Security: Master encryption & session signing secrets (auto-generated locally if omitted)
DB_ENCRYPTION_KEY=""
SESSION_SECRET=""
SYNC_API_TOKEN=""

# SSL / TLS Certificate Paths (for on-premise HTTPS server)
SSL_CERT_PATH=""
SSL_KEY_PATH=""
SSL_CA_PATH=""

# On-premise SMB / Network Share Configuration (e.g. \\192.168.0.50\ShareName)
SMB_SERVER_HOST="192.168.0.50"
SMB_SHARE_PATH=""
ENABLE_LOCAL_UNC_SYNC="false"
